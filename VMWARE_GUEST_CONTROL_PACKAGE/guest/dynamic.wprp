<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="r_AKanaly">
  <Profiles>
    <SystemCollector Id="DynamicCollector" Name="r_AKanaly kernel events">
      <BufferSize Value="1024"/><Buffers Value="64"/>
    </SystemCollector>
    <SystemProvider Id="DynamicProvider">
      <Keywords><Keyword Value="ProcessThread"/><Keyword Value="Loader"/></Keywords>
    </SystemProvider>
    <Profile Id="Dynamic.Verbose.File" Name="Dynamic" Description="Process, thread and image events" LoggingMode="File" DetailLevel="Verbose">
      <Collectors><SystemCollectorId Value="DynamicCollector"><SystemProviderId Value="DynamicProvider"/></SystemCollectorId></Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
